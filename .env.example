# API UAU (ambiente de teste da CAC)
UAU_BASE_URL=https://apiglobalteccac.fwc.cloud:36000
UAU_API_VERSION=1
UAU_USUARIO=
# Aspas obrigatórias se a senha tiver #, !, ou outros caracteres especiais
UAU_SENHA=""
UAU_INTEGRATION_TOKEN=
UAU_EMPRESA=9999
UAU_ORCAMENTO=1

# true = usa obras/insumos de fixture, sem chamar a API UAU
UAU_MOCK=false

# LLM: test | openai | groq | mock
# test = não gasta tokens; marca insumos da categoria abaixo como inválidos
LLM_PROVIDER=test
TEST_LLM_FLAGGED_CATEGORY=pro

# Só necessário se LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Só necessário se LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Login do portal (aspas se a senha tiver #)
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=admin
AUTH_SECRET=troque-este-segredo
